services:

  # ─── Infrastructure ───────────────────────────────────────────────────────────

  postgres:
    image: postgres:17
    container_name: postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "5432:5432"   # exposed for local dev debugging
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./infra/postgres/init:/docker-entrypoint-initdb.d
    networks:
      - internal
    restart: unless-stopped

  zookeeper:
    image: confluentinc/cp-zookeeper:7.7.0
    container_name: zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks:
      - internal
    restart: unless-stopped

  kafka:
    image: confluentinc/cp-kafka:7.7.0
    container_name: kafka
    depends_on:
      - zookeeper
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_LISTENERS: INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9093
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://kafka:9092,EXTERNAL://localhost:9093
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
    ports:
      - "9093:9093"   # exposed for local dev (services running outside Docker)
    networks:
      - internal
    restart: unless-stopped

  minio:
    image: minio/minio:latest
    container_name: minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    ports:
      - "9000:9000"   # S3 API — exposed for local dev
      - "9001:9001"   # MinIO Console — exposed for local dev
    volumes:
      - minio_data:/data
    networks:
      - internal
    restart: unless-stopped

  # ─── Application services (profile: app) ─────────────────────────────────────
  # Start with: docker compose --profile app up

  gateway:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-gateway/Dockerfile
    container_name: gateway
    ports:
      - "8080:8080"
    environment:
      JWT_SECRET: ${JWT_SECRET}
      JWT_ENABLED: ${JWT_ENABLED:-true}
      USERS_SERVICE_URL: ${USERS_SERVICE_URL}
      FINANCES_SERVICE_URL: ${FINANCES_SERVICE_URL}
      CARDS_SERVICE_URL: ${CARDS_SERVICE_URL}
      NOTIFICATIONS_SERVICE_URL: ${NOTIFICATIONS_SERVICE_URL}
      UPLOAD_SERVICE_URL: ${UPLOAD_SERVICE_URL}
      INVESTMENTS_SERVICE_URL: ${INVESTMENTS_SERVICE_URL}
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS}
    depends_on:
      - service-users
      - service-finances
      - service-cards
      - service-notifications
      - service-upload
      - service-investments
    networks:
      - internal
    restart: unless-stopped

  service-users:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-users/Dockerfile
    container_name: service-users
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: ${KAFKA_BOOTSTRAP_SERVERS}
      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRATION: ${JWT_EXPIRATION}
      JWT_REFRESH_EXPIRATION: ${JWT_REFRESH_EXPIRATION}
      COOKIE_SECURE: ${COOKIE_SECURE:-false}
    depends_on:
      - postgres
      - kafka
    networks:
      - internal
    restart: unless-stopped

  service-banks:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-banks/Dockerfile
    container_name: service-banks
    environment:
      DB_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}?currentSchema=banks
      DB_USERNAME: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: ${KAFKA_BOOTSTRAP_SERVERS}
    depends_on:
      - postgres
      - kafka
    networks:
      - internal
    restart: unless-stopped

  service-notifications:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-cards/Dockerfile
    container_name: service-cards
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: ${KAFKA_BOOTSTRAP_SERVERS}
    depends_on:
      - postgres
      - kafka
    networks:
      - internal
      test: ["CMD", "curl", "-f", "http://localhost:8084/actuator/health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s

  service-upload:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-upload/Dockerfile
    container_name: service-upload
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: ${KAFKA_BOOTSTRAP_SERVERS}
      MINIO_ENDPOINT: http://minio:9000
      MINIO_ACCESS_KEY: ${MINIO_ROOT_USER}
      MINIO_SECRET_KEY: ${MINIO_ROOT_PASSWORD}
      MINIO_BUCKET_STATEMENTS: ${MINIO_BUCKET_STATEMENTS}
      MINIO_BUCKET_RECEIPTS: ${MINIO_BUCKET_RECEIPTS}
    depends_on:
      - postgres
      - kafka
      - minio
    networks:
      - internal
    restart: unless-stopped

  service-investments:
    profiles: [app]
    build:
      context: ./back
      dockerfile: ms-investments/Dockerfile
    container_name: service-investments
    environment:
      DB_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}?currentSchema=investments
      DB_USERNAME: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      IOL_USERNAME: ${IOL_USERNAME}
      IOL_PASSWORD: ${IOL_PASSWORD}
    depends_on:
      - postgres
    networks:
      - internal
    restart: unless-stopped

  frontend:
    profiles: [app]
    build:
      context: ./front/financial-app
      args:
        NEXT_PUBLIC_GATEWAY_URL: ${NEXT_PUBLIC_GATEWAY_URL}
    container_name: frontend
    ports:
      - "3000:3000"
    environment:
      NEXT_PUBLIC_GATEWAY_URL: ${NEXT_PUBLIC_GATEWAY_URL}
    depends_on:
      - gateway
    networks:
      - internal
    restart: unless-stopped

volumes:
  postgres_data:
  minio_data:

networks:
  internal:
    driver: bridge
