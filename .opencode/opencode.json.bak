{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/deepseek-ai/deepseek-v4-flash",
  "plugin": [
    "caveman"
  ],
  "provider": {
    "nvidia": {
      "options": {
        "additionalPayload": {
          "chat_template_kwargs": {
            "enable_thinking": true,
            "thinking": true
          }
        }
      }
    }
  },
  "limit": {
    "context": 262144
  }
}
