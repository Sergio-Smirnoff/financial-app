# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=financialapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=financialapp

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Any long random string works. Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── Internal service auth ──────────────────────────────────
# Shared secret for service-to-service calls (sent as the X-Internal-Token header).
# REQUIRED by every backend service — they hard-fail at startup if it is unset.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=change_this_to_a_long_random_internal_token

# ─── Gateway ──────────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=600

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_STATEMENTS=statements
MINIO_BUCKET_RECEIPTS=receipts

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Docker (inter-container): kafka:9092  |  Local dev: localhost:9093
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Kafka (KRaft) ────────────────────────────────────────────────────────────
# Single-node KRaft needs a fixed cluster id (base64 UUID). Without it the broker
# re-formats its storage on every recreate. Generate a fresh one with:
#   docker run --rm confluentinc/cp-kafka:7.7.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=qdoHEYVNSfGthfOyXUp2rQ

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Grafana admin login (UI at https://${DOMAIN_NAME}/grafana)
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password
# Swagger UI basic-auth (https://${DOMAIN_NAME}/swagger-ui.html). htpasswd format.
# Generate:  htpasswd -nb admin 'yourpassword'
# IMPORTANT: in a .env file the hash is used verbatim — do NOT double the $ signs.
# (Doubling to $$ is only needed when the value is inline in the compose YAML.)
SWAGGER_AUTH=admin:$apr1$abcdefgh$ijklmnopqrstuvwxyz0123

# ─── Service URLs (used by Gateway) ──────────────────────────────────────────
USERS_SERVICE_URL=http://service-users:8081
FINANCES_SERVICE_URL=http://service-finances:8082
BANKS_SERVICE_URL=http://service-banks:8083
NOTIFICATIONS_SERVICE_URL=http://service-notifications:8084
UPLOAD_SERVICE_URL=http://service-upload:8085
INVESTMENTS_SERVICE_URL=http://service-investments:8086

# ─── IOL (InvertirOnline) ────────────────────────────────────────────────────
IOL_USERNAME=your_iol_email
IOL_PASSWORD=your_iol_password

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to true in production (HTTPS)
COOKIE_SECURE=false

# ─── Gateway ──────────────────────────────────────────────────────────────────
JWT_ENABLED=true
# Comma-separated list of allowed origins. Add your local IP for mobile testing.
# Example: https://midominio.com,http://localhost,http://192.168.0.218
ALLOWED_ORIGINS=https://${DOMAIN_NAME},http://localhost,http://192.168.0.218

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=https://${DOMAIN_NAME}/api

# ─── Traefik / SSL ────────────────────────────────────────────────────────────
DOMAIN_NAME=tu-dominio.duckdns.org
ACME_EMAIL=tu@email.com

# ─── DuckDNS (Auto-update IP) ─────────────────────────────────────────────────
# Token from duckdns.org
DUCKDNS_TOKEN=tu-token-aqui
# Subdomain only (without .duckdns.org)
DUCKDNS_DOMAIN=tu-subdominio-aqui

# ─── Notifications ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=changeme
NOTIFICATION_SCHEDULER_CRON="0 8 * * *"

# ─── Image versions (deploy pinning) ──────────────────────────────────────────
# Semver tags published by the Release workflow (e.g. 1.2.0); unset = latest.
# Rollback = set the previous version and re-run: docker compose --profile app up -d
GATEWAY_VERSION=latest
USERS_VERSION=latest
FINANCES_VERSION=latest
BANKS_VERSION=latest
NOTIFICATIONS_VERSION=latest
UPLOAD_VERSION=latest
INVESTMENTS_VERSION=latest
FRONTEND_VERSION=latest
