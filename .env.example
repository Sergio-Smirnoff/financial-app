# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=financialapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=financialapp

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Any long random string works. Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── Internal service auth ──────────────────────────────────
# Shared secret for service-to-service calls (sent as the X-Internal-Token header).
# REQUIRED by every backend service — they hard-fail at startup if it is unset.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=change_this_to_a_long_random_internal_token

# ─── Gateway ──────────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=600

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_STATEMENTS=statements
MINIO_BUCKET_RECEIPTS=receipts

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Docker (inter-container): kafka:9092  |  Local dev: localhost:9093
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Kafka (KRaft) ────────────────────────────────────────────────────────────
# Single-node KRaft needs a fixed cluster id (base64 UUID). Without it the broker
# re-formats its storage on every recreate. Generate a fresh one with:
#   docker run --rm confluentinc/cp-kafka:7.7.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=qdoHEYVNSfGthfOyXUp2rQ

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Grafana admin login (UI at https://${DOMAIN_NAME}/grafana)
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password
# Grafana keeps serving from the /grafana sub-path on every hostname, because
# GF_SERVER_SERVE_FROM_SUB_PATH makes it emit root-relative asset URLs. Only the
# absolute links Grafana generates itself (alert notifications, share links)
# follow the host below. Leave empty to track DOMAIN_NAME; override only to move
# Grafana to a dedicated hostname, which also means dropping the sub-path.
GRAFANA_ROOT_URL=
# Swagger UI basic-auth now lives in the edge stack (homelab-infra stacks/edge).

# ─── Service URLs (used by Gateway) ──────────────────────────────────────────
USERS_SERVICE_URL=http://service-users:8081
FINANCES_SERVICE_URL=http://service-finances:8082
BANKS_SERVICE_URL=http://service-banks:8083
NOTIFICATIONS_SERVICE_URL=http://service-notifications:8084
UPLOAD_SERVICE_URL=http://service-upload:8085
INVESTMENTS_SERVICE_URL=http://service-investments:8086

# ─── IOL (InvertirOnline) ────────────────────────────────────────────────────
IOL_USERNAME=your_iol_email
IOL_PASSWORD=your_iol_password

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to true in production (HTTPS)
COOKIE_SECURE=false

# ─── Gateway ──────────────────────────────────────────────────────────────────
JWT_ENABLED=true
# Comma-separated list of allowed origins. Add your local IP for mobile testing.
# Example: https://midominio.com,http://localhost
#
# TLS terminates at the edge, so the gateway sees http://gateway:8080 while the
# browser sends Origin: https://<host>. Spring therefore treats even same-host
# requests as CORS ones, which means EVERY hostname the app is served on must be
# listed here or state-changing calls (login, POST/PUT/DELETE) fail with 403.
#
# Leave EMPTY to let compose derive it as
#   https://${DOMAIN_NAME}[,https://${SECONDARY_DOMAIN_NAME}],http://localhost
# which is the normal case — set SECONDARY_DOMAIN_NAME to serve both hostnames
# at once. Set a value here only to pin the list by hand; it then wins outright.
ALLOWED_ORIGINS=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Leave EMPTY. The published frontend image is built with no
# NEXT_PUBLIC_GATEWAY_URL build-arg, so the client bundle inlines an empty base
# URL and calls the gateway same-origin at /api (the edge routes PathPrefix
# `/api` to the gateway with no prefix stripping). An empty base is what lets a
# single image serve every hostname; setting an absolute URL here would pin the
# build to one host and produce a broken double `/api/api/v1/...` path.
NEXT_PUBLIC_GATEWAY_URL=

# ─── Domain ───────────────────────────────────────────────────────────────────
# Primary public hostname of the deployment. Consumed by ALLOWED_ORIGINS and
# GF_SERVER_ROOT_URL.
# TLS/ACME and dynamic DNS are owned by the edge stack (homelab-infra
# stacks/edge), not by this file.
DOMAIN_NAME=tu-dominio.duckdns.org

# Optional second public hostname, served alongside DOMAIN_NAME. Set it during a
# domain migration so both hostnames are accepted at the same time; leave empty
# when there is only one. Adding it is additive — DOMAIN_NAME keeps working.
SECONDARY_DOMAIN_NAME=

# ─── Notifications ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=changeme
NOTIFICATION_SCHEDULER_CRON="0 8 * * *"

# ─── Image versions (deploy pinning) ──────────────────────────────────────────
# Semver tags published by the Release workflow (e.g. 1.2.0); unset = latest.
# Rollback = set the previous version and re-run: docker compose --profile app up -d
GATEWAY_VERSION=latest
USERS_VERSION=latest
FINANCES_VERSION=latest
BANKS_VERSION=latest
NOTIFICATIONS_VERSION=latest
UPLOAD_VERSION=latest
INVESTMENTS_VERSION=latest
FRONTEND_VERSION=latest
